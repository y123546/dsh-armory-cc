#!/bin/sh
# rebase / amend 之后同样重放补丁（这类操作不走 post-merge）。
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0
[ -f apply-patches.mjs ] || exit 0

NODE=$(command -v node 2>/dev/null)
if [ -z "$NODE" ] && [ -x "/f/Deepseek/data/dsh-home/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/node.exe" ]; then
  NODE="/f/Deepseek/data/dsh-home/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/node.exe"
fi
[ -z "$NODE" ] && exit 0

"$NODE" apply-patches.mjs
exit 0
