#!/bin/sh
# 合并完成后自动重放本地补丁。
# 上游每次发版都会重建 lib/，所以 merge/pull 之后必须把 patches/ 重新打一遍，
# 否则会悄悄退回上游版本（菜单定位问题复发）。已应用过的补丁会被脚本跳过。
#
# 启用方式（仓库内一次即可）：git config core.hooksPath .githooks

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

[ -f apply-patches.mjs ] || exit 0

NODE=$(command -v node 2>/dev/null)
if [ -z "$NODE" ] && [ -x "/f/Deepseek/data/dsh-home/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/node.exe" ]; then
  NODE="/f/Deepseek/data/dsh-home/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/node.exe"
fi
if [ -z "$NODE" ]; then
  echo "[apply-patches] 没找到 node，跳过自动重放补丁"
  exit 0
fi

echo ""
echo "── 合并完成，自动重放补丁 ──────────────────────────"
"$NODE" apply-patches.mjs
status=$?
echo "──────────────────────────────────────────────────"
if [ $status -ne 0 ]; then
  echo "[apply-patches] 有补丁没打上（多半是上游改动了同一段代码）。"
  echo "  按 patches/README.md 的说明手工改一遍，再生成新的 000N-*.patch。"
fi
exit 0
